# Docker: copy to ".env" next to docker-compose.yml and compose picks it up automatically.
# Local dev (no Docker): copy to "backend/.env" instead - load_dotenv() reads it from there.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
# Self-imposed daily cap on Gemini API calls (see backend/app/quota_guard.py), just a
# safety net against a runaway bug/loop. On the free tier (20 requests/day), set this
# to ~18. On a paid plan the real constraint is per-minute throughput, not a daily
# count, so this can stay generous - default 200.
GEMINI_DAILY_CALL_BUDGET=200
