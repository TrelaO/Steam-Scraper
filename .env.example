# Docker: copy to ".env" next to docker-compose.yml and compose picks it up automatically.
# Local dev (no Docker): copy to "backend/.env" instead - load_dotenv() reads it from there.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
# Self-imposed daily cap on Gemini API calls (see backend/app/quota_guard.py). Default 18,
# a couple below Google's free-tier limit of 20/day, so the app stops itself before a real
# 429. Raise this once you're on a paid plan.
GEMINI_DAILY_CALL_BUDGET=18
